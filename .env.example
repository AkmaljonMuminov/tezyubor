# Nusxa oling: cp .env.example .env  va qiymatlarni O'ZGARTIRING. .env Git'ga QO'SHILMAYDI.
APP_ENV=development
# Kamida 32 belgi, ikkalasi har xil. Yaratish: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OTP_SECRET=

# --- SMS (productionda majburiy) ---
# none | eskiz. Productionda `none` bo'lsa ilova ishga tushmaydi.
SMS_PROVIDER=none
# SMS_PROVIDER=eskiz bo'lsa to'ldiring. Bu qiymatlar FAQAT serverning .env faylida turadi, Git'ga va chatga yozilmaydi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Jo'natuvchi nomi (Eskiz'da tasdiqlangan bo'lishi kerak)
ESKIZ_FROM=4546
# Matn Eskiz'da tasdiqlangan shablonga mos bo'lishi kerak. {code} o'rniga kod qo'yiladi.
SMS_TEMPLATE=Tezyubor tasdiqlash kodi: {code}
# Bir sutkada yuboriladigan jami SMS (hisobdagi pulni tasodifan yoki qasddan tugatib qo'ymaslik uchun)
SMS_DAILY_CAP=500
