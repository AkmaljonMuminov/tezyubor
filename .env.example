# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring. .env Git'ga QO'SHILMAYDI.
# DIQQAT: .env.example ochiq repozitoriyga yuklanadi. Bu yerga HECH QACHON haqiqiy parol, kalit yoki shaxsiy
# ma'lumot yozmang. Haqiqiy qiymatlar faqat serverdagi .env faylida turadi.
APP_ENV=production

# Maxfiy kalitlar: kamida 32 belgi, ikkalasi har xil.
# Yaratish: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OTP_SECRET=

# --- SMS (productionda majburiy) ---
# none | eskiz. Productionda `none` bo'lsa ilova ishga tushmaydi.
SMS_PROVIDER=eskiz
# Eskiz kabinetidagi login va parol (faqat serverdagi .env da to'ldiriladi)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Jo'natuvchi nomi (Eskiz'da tasdiqlangan bo'lishi kerak)
ESKIZ_FROM=4546
# Matn Eskiz'da tasdiqlangan shablonga mos bo'lishi kerak. {code} o'rniga kod qo'yiladi.
SMS_TEMPLATE=Tezyubor tasdiqlash kodi: {code}. Ushbu kodni hech kimga bermang! Uni firibgarlar so'rashi mumkin.
# BUTUN TIZIM bo'yicha limitlar (har bir foydalanuvchi uchun emas): hisobdagi pul tugab qolmasligi uchun.
# Sutkada jami SMS soni va 8 soat ichida jami SMS soni (SMS_8HOUR_CAP=0 — o'chirilgan).
SMS_DAILY_CAP=9
SMS_8HOUR_CAP=3

# --- PIN qo'shimcha himoya (ixtiyoriy, lekin tavsiya etiladi) ---
# Bo'sh bo'lsa PIN xeshi faqat scrypt bilan. To'ldirilsa (>=32 belgi), bazaning o'zi sizib chiqsa ham 4 xonali PIN'ni taxmin qilib bo'lmaydi.
# Eslatma: keyin o'zgartirilsa yoki yo'qolsa, shu kalit bilan yaratilgan PIN'lar tekshirilmaydi (foydalanuvchilar qayta o'rnatishi kerak).
PIN_PEPPER=

# --- Hamyon: SANDBOX (haqiqiy bank ulanmagan, barcha pul — sinov qiymat) ---
# Standart: o'chirilgan. Yoqish uchun WALLET_ENABLED=true va CARD_INDEX_KEY (>=32 belgi, boshqa sirlardan farqli) kerak.
WALLET_ENABLED=false
CARD_INDEX_KEY=
# Quyidagilar O'RINBOSAR qiymatlar (biznes qaror kutilmoqda), tiyinda (1 so'm = 100 tiyin):
# TRANSFER_FEE_BPS=0                 komissiya, 1 bps = 0,01%
# TRANSFER_FEE_MIN_TIYIN=0
# TRANSFER_MIN_TIYIN=100000          1 000 so'm
# TRANSFER_MAX_TIYIN=500000000       5 000 000 so'm
# TRANSFER_DAILY_LIMIT_TIYIN=1000000000
# SANDBOX_START_BALANCE_TIYIN=100000000   yangi karta uchun sinov balans
